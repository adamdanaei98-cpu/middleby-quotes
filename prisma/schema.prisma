// prisma/schema.prisma
// Middleby Food Processing - Quote Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS & AUTH ─────────────────────────────────────────────

enum Role {
  salesperson
  reviewer
  manager
  supervisor
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String   // bcrypt hashed
  role          Role     @default(salesperson)
  companyAccess String[] // company keys this user can access
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  createdQuotes  Quote[]       @relation("CreatedBy")
  reviewedQuotes Quote[]       @relation("ReviewedBy")
  approvedQuotes Quote[]       @relation("ApprovedBy")
  auditLogs      AuditLog[]
}

// ─── CUSTOMERS ────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  plant     String?
  address   String?
  contact   String?
  email     String?
  phone     String?
  rep       String?  // default sales rep name
  industry  String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]
}

// ─── COMPANIES (sub-brands) ───────────────────────────────────

model Company {
  id           String  @id @default(cuid())
  key          String  @unique // e.g. "rvp", "thurne", "pacpro"
  name         String
  color        String  @default("#0074BB")
  description  String?
  execSummary  String?
  logo         String? // base64 or URL
  machineImage String? // base64 or URL

  // Financial rates (stored as JSON for flexibility)
  rates Json @default("{}")

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalogSections CatalogSection[]
}

// ─── CATALOG ──────────────────────────────────────────────────

model CatalogSection {
  id        String  @id @default(cuid())
  companyId String
  name      String
  sortOrder Int     @default(0)

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   CatalogItem[]

  @@unique([companyId, name])
}

model CatalogItem {
  id        String @id @default(cuid())
  sectionId String
  name      String
  fixedPrice  Float  @default(0)
  variablePrice Float @default(0)
  materialCost  Float @default(0)
  laborHours    Float @default(0)
  description   String?
  note          String?
  hasQuantity   Boolean @default(false)
  quantityLabel String?

  // Options stored as JSON array: [{name, fixedPrice, variablePrice}]
  options Json?

  // Sub-options stored as JSON
  subOptions Json?

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section CatalogSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

// ─── QUOTES ───────────────────────────────────────────────────

enum QuoteStatus {
  draft
  submitted    // salesperson submitted to reviewer
  reviewed     // reviewer approved, sent to manager
  approved     // manager approved - final
  rejected     // rejected at any stage
  expired
}

model Quote {
  id             String      @id @default(cuid())
  quoteNumber    String      @unique // e.g. "QC-100391"
  revision       Int         @default(1)
  status         QuoteStatus @default(draft)
  mode           String      @default("bundle") // "bundle" or "individual"

  // Customer
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  customerName   String?     // denormalized for quick access
  contactName    String?
  contactEmail   String?
  plantName      String?
  repName        String?

  // Purpose / notes
  purpose        String?

  // The full quote data snapshot (selections, pricing at time of save)
  selections     Json        // {companyKey: {itemId: {on, op, q, subs}}}
  pricingSnapshot Json?      // frozen pricing at time of finalization
  grandTotal     Float       @default(0)

  // Which companies are involved
  companyKeys    String[]

  // Workflow
  createdById    String?
  createdBy      User?       @relation("CreatedBy", fields: [createdById], references: [id])

  submittedAt    DateTime?
  submitNote     String?

  reviewerId     String?
  reviewedBy     User?       @relation("ReviewedBy", fields: [reviewerId], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?

  managerId      String?
  approvedBy     User?       @relation("ApprovedBy", fields: [managerId], references: [id])
  approvedAt     DateTime?
  managerNote    String?

  // Expiration
  expiresAt      DateTime?

  // Terms snapshot
  terms          String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  auditLogs AuditLog[]
}

// ─── AUDIT LOG ────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  quoteId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // "created", "submitted", "reviewed", "approved", "rejected", "price_changed", etc.
  details   Json?    // {field: "fixedPrice", oldValue: 100, newValue: 200}
  createdAt DateTime @default(now())
}
